{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "派大星 - 默认权限配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-close",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "fs:default",
    "fs:allow-read-file",
    "opener:default"
  ]
}
